{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/brand-icons/:path*", "destination": "https://www.google.com/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
